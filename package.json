{
  "name": "peterparker-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "tauri:dev": "pnpm --filter @peterparker/tauri dev",
    "tauri:build": "pnpm --filter @peterparker/tauri build"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
