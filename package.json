{
  "name": "peterparker-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter @peterparker/web dev",
    "dev:tauri": "pnpm --filter @peterparker/tauri dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @peterparker/web build",
    "build:tauri": "pnpm --filter @peterparker/tauri build",
    "build:tauri:mac": "pnpm --filter @peterparker/tauri build:mac",
    "build:tauri:win": "pnpm --filter @peterparker/tauri build:win",
    "build:tauri:linux": "pnpm --filter @peterparker/tauri build:linux",
    "build:core": "cargo build --manifest-path packages/core/Cargo.toml",
    "build:core:release": "cargo build --release --manifest-path packages/core/Cargo.toml",
    "test": "turbo run test",
    "test:core": "cargo test --manifest-path packages/core/Cargo.toml",
    "test:web": "pnpm --filter @peterparker/web test",
    "lint": "turbo run lint",
    "check": "turbo run check && cargo check --manifest-path packages/core/Cargo.toml",
    "clean": "pnpm run clean:node && pnpm run clean:rust",
    "clean:node": "rm -rf node_modules apps/*/node_modules packages/*/node_modules pnpm-lock.yaml",
    "clean:rust": "cargo clean --manifest-path packages/core/Cargo.toml && cargo clean --manifest-path apps/tauri/src-tauri/Cargo.toml",
    "format": "turbo run format",
    "format:rust": "cargo fmt --manifest-path packages/core/Cargo.toml && cargo fmt --manifest-path apps/tauri/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
