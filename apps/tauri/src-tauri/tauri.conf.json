{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeterParker",
  "version": "0.1.0",
  "identifier": "com.peterparker.app",
  "build": {
    "beforeBuildCommand": "cd ../web && pnpm build",
    "beforeDevCommand": "cd ../web && pnpm dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PeterParker - Network Scanner",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.svg"
    ],
    "category": "Utility",
    "shortDescription": "LAN Network Scanner",
    "longDescription": "PeterParker scans your local network to discover devices and provides detailed information about each device.",
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "ping",
          "cmd": "ping",
          "args": true
        }
      ]
    }
  }
}
