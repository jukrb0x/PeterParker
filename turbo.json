{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "dist/**", "build/**", "src-tauri/target/**"]
    },
    "build:mac": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/**"]
    },
    "build:win": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/**"]
    },
    "build:linux": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:run": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "format": {}
  }
}
